<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_form_inherit_base_grok" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.base.grok</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
                <block name="integration" position="inside">
                    <setting id="grok_spreadsheet_setting" string="Grok Spreadsheet Assistant" documentation="https://www.bizylife.com/knowledge/article/143">
                        <span class="text-muted">
                            Amazing U.S. Sourced Developments available at <a href="https://www.bizylife.com" target="_blank">BizyLife.com</a>
                        </span>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="grok_api_key" string="API Key:" class="col-lg-3 o_light_label"/>
                                <field name="grok_api_key" placeholder="e.g. d7vctmiv2rwgenebha8bxq7irooudn"/>
                            </div>
                            <div class="row mt16">
                                <label for="grok_version" string="Grok Version:" class="col-lg-3 o_light_label"/>
                                <field name="grok_version" default="grok-4"/>
                            </div>
                        </div>
                    </setting>
                </block>
        </field>
    </record>

</odoo>